{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cave",
  "version": "0.1.0",
  "identifier": "fr.umebrunet.cave.ui",
  "build": {
    "frontendDist": "front"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cave",
        "width": 960,
        "height": 640,
        "minWidth": 680,
        "minHeight": 440,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
